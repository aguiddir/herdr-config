# Herdr writes everything else here (window state, shipped mods and layouts,
# generated types): only what is mine is tracked.
/*
!/.gitignore
!/README.md
!/install.sh
!/keys.json
!/settings.json
!/layouts/
/layouts/*
!/layouts/mine.json
!/hc-templates/
!/mods/
/mods/*
!/mods/start-work/
!/mods/clean-merged/
!/mods/pr-inbox/
!/mods/pipeline/
/mods/*/gpui-kit.d.ts
/mods/*/herdr.d.ts
/mods/*/jsconfig.json
/mods/pipeline/config.json
.superpowers/
